# =============================================================================
# THE GROWTH ARCHIVE — ENVIRONMENT CONFIGURATION
# =============================================================================

# Canonical Production Database: PostgreSQL 16+
# e.g. "postgresql://user:password@localhost:5432/the_growth_archive?schema=public"
# Local Development Fallback: "file:./dev.db" (SQLite WAL Mode)
DATABASE_URL="file:./dev.db"

# Admin Provisioning (Used by scripts/create-admin.ts)
# NOTE: ADMIN_SECRET_KEY is removed. Admin authentication uses scrypt identity credentials.
ADMIN_EMAIL="admin@thegrowtharchive.com"
ADMIN_PASSWORD="ReplaceWithSecurePassphrase2026!#"

# Session & Cryptographic Cookie Secret (Minimum 32 characters)
SESSION_SECRET="growth_archive_session_secret_cryptographically_secure_2026"

# Razorpay Configuration (Server-Side)
RAZORPAY_KEY_ID="rzp_test_growtharchive"
RAZORPAY_KEY_SECRET="growth_secret_key_mock"
RAZORPAY_WEBHOOK_SECRET="webhook_secret_hash_verify"

# Razorpay Public Key (Client-Side)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_growtharchive"

# App & Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage Provider: "local" (default) or "r2" / "s3"
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage/products"

# Cloudflare R2 Storage (10 GB Free Storage, $0 Download Bandwidth)
# In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Token
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Email Outbox Provider (Resend or SMTP - fallback to file/console mock if empty)
RESEND_API_KEY=""
EMAIL_FROM="The Growth Archive <orders@thegrowtharchive.com>"

# Rate Limiting (Optional Upstash Redis - fallback to PostgreSQL RateLimitBucket table)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
