{
  "name": "the-growth-archive",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "bash ./scripts/setup-mac.sh",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "tsx scripts/test-all.ts",
    "demo": "tsx scripts/start-local-demo.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "^6.19.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
